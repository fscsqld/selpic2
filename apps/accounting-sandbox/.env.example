# SELPIC A (accounting-sandbox) — copy to .env.local
# Bank PDF AI classification (optional for UI; required for PDF upload analysis)
OPENAI_API_KEY=

# Storefront origin for "Back to admin dashboard" after SSO My Payroll logout.
# Local storefront is often :3000 or :3005; production e.g. https://selpic.com.au
NEXT_PUBLIC_STOREFRONT_URL=http://localhost:3000
