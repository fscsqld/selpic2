{
  "installCommand": "npm install --legacy-peer-deps",
  "crons": [
    {
      "path": "/api/cron/fundraising-renewal",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/fundraising-outreach-daily",
      "schedule": "0 21 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "selpic2.vercel.app" }],
      "destination": "https://selpic.com.au/:path*",
      "permanent": true
    }
  ]
}
